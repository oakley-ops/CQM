# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cqm_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
# Generate a strong secret, e.g.: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=1d

# Registration
# Accounts are admin-provisioned by default. Set to true to allow open self-signup.
ALLOW_PUBLIC_REGISTRATION=false

# Initial Admin User (used by create-admin.js)
# ADMIN_PASSWORD is required to run create-admin.js; choose a strong value.
ADMIN_EMAIL=admin@cqm.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# AI Providers (used by NEXUS AI insights, RAG, and the autodata pipeline)
GROQ_API_KEY=your_groq_api_key       # LLM generation
VOYAGE_API_KEY=your_voyage_api_key   # RAG embeddings

# CORS Configuration
CORS_ORIGIN=http://localhost:3007

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis (optional â€” used for JWT token blocklist on user deactivation)
# Leave unset to disable Redis; the system degrades gracefully without it.
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Email Configuration (Gmail)
EMAIL_USER=service@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

