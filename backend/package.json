{
  "name": "cqm-backend",
  "version": "1.0.0",
  "description": "Card Quality Management (CQM) Tracking System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore vector-stores/ --ignore uploads/ server.js",
    "migrate": "node db/migrate.js",
    "seed-scope": "node seed-scope-data.js",
    "seed-resources": "node seed-resources-data.js",
    "seed-communications": "node seed-communications-data.js",
    "seed-test-categories": "node seed-test-categories.js",
    "seed-test-definitions": "node seed-test-definitions.js",
    "seed-cqm": "npm run seed-test-categories && npm run seed-test-definitions",
    "seed-icc": "node seed-icc-tests.js",
    "seed-internal": "node seed-internal-tests.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "cqm",
    "card-quality-management",
    "smart-card",
    "iso-compliance",
    "quality-management",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "archiver": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "file-type": "^16.5.4",
    "googleapis": "^128.0.0",
    "groq-sdk": "^1.1.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^24.35.0",
    "sequelize": "^6.35.2",
    "socket.io": "^4.6.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "vectra": "^0.12.3",
    "voyageai": "^0.2.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
